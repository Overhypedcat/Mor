{
  "manifest_version": 2,
  "name": "Mor",
  "version": "0.1.5",
  "description": "Twitch music filter and 1440p unlock: takes the songs streamers play out of the sound, and plays region-locked 1440p streams through your own VPN.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mor@overhypedcat",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/Overhypedcat/Mor/main/updates.json",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/mor.svg",
    "96": "icons/mor.svg",
    "128": "icons/mor.svg"
  },
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "proxy",
    "cookies",
    "storage",
    "tabs",
    "*://*.twitch.tv/*",
    "*://*.ttvnw.net/*",
    "*://*.live-video.net/*"
  ],
  "background": {
    "scripts": ["lib/shared.js", "background/main.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*", "https://m.twitch.tv/*", "https://player.twitch.tv/*"],
      "js": ["lib/shared.js", "content/player-row.js", "content/twitch.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": ["audio/filter-worklet.js"],
  "browser_action": {
    "default_icon": "icons/mor.svg",
    "default_title": "Mor",
    "default_popup": "hub/hub.html"
  }
}
